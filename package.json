{
  "name": "warframe-companion-app",
  "version": "1.9.1",
  "description": "Ordis - unofficial Warframe companion app for tracking progress and navigating game content. Based on Warframe Companion App by Hassan F.",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage pacman",
    "build:mac": "electron-builder --mac dmg zip",
    "package": "electron-builder --win --dir",
    "verify:riven-bases": "node verify-riven-bases.js"
  },
  "author": "Kawaoii",
  "license": "LicenseRef-MIT-With-Attribution",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@napi-rs/system-ocr": "^1.2.0",
    "electron-updater": "^6.6.2",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "io.github.kawaoii.ordis",
    "productName": "Ordis",
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/ordis-mark.png",
      "artifactName": "Ordis-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "artifactName": "Ordis-${version}-${arch}.${ext}",
      "category": "Utility",
      "icon": "assets/ordis-mark.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Ordis-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kawaoii",
        "repo": "Ordis"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "relic-overlay.html",
      "riven-overlay.html",
      "riven-overlay-dashboard.html",
      "index.html",
      "styles.css",
      "ordis-design.css",
      "renderer.js",
      "dock.js",
      "splitview.js",
      "market.js",
      "wfm-contracts.js",
      "starchart.js",
      "riven-data.js",
      "riven-parser.js",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@41.0.3": true
  }
}
